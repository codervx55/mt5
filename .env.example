# ============================================================
# MT5 -> TELEGRAM SIGNAL BOT - ENVIRONMENT CONFIGURATION
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env file to GitHub.
# ============================================================

# ---------------- MetaTrader 5 ----------------
# Leave these blank to use the terminal that is already logged in.
# Fill them in if you want the bot to log in itself.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Full path to terminal64.exe, e.g. C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TERMINAL_PATH=

# ---------------- Telegram ----------------
# Create a bot with @BotFather, then paste the token below.
TELEGRAM_BOT_TOKEN=
# Your personal or group chat id (see README "Finding Chat ID").
TELEGRAM_CHAT_ID=

# ---------------- Trading Pairs ----------------
# Comma separated list of MT5 symbol names.
SYMBOLS=BTCUSD,ETHUSD,XAUUSD

# Comma separated list of timeframes to scan. Supported: M1,M5,M15,M30,H1,H4,D1
TIMEFRAMES=M5,M15
# The higher timeframe used to confirm the lower timeframe signal.
CONFIRMATION_TIMEFRAME=M15

# ---------------- Strategy ----------------
RISK_REWARD_RATIO=2.6
VOLUME_LOOKBACK=20
VOLUME_MULTIPLIER=1.2
MIN_CONFIDENCE_SCORE=80

# Confidence weighting (must sum to 100, but the code will normalize if not)
WEIGHT_VWAP=20
WEIGHT_STRUCTURE=25
WEIGHT_VOLUME=20
WEIGHT_CANDLESTICK=20
WEIGHT_TREND=15

# ---------------- Duplicate Protection ----------------
SIGNAL_COOLDOWN_MINUTES=30
ACTIVE_SIGNALS_FILE=signals/active_signals.json

# ---------------- Sessions (UTC) ----------------
# Options: LONDON, NEWYORK, BOTH, OFF
SESSION_FILTER=BOTH
LONDON_SESSION_START=07:00
LONDON_SESSION_END=16:00
NEWYORK_SESSION_START=12:00
NEWYORK_SESSION_END=21:00

# ---------------- Scanner ----------------
SCAN_INTERVAL_SECONDS=10
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_BACKOFF_SECONDS=5

# ---------------- Logging ----------------
LOG_FILE=logs/bot.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# ---------------- CSV History ----------------
CSV_HISTORY_FILE=signals/signal_history.csv

# ---------------- Heartbeat ----------------
HEARTBEAT_INTERVAL_HOURS=6

# ---------------- Daily Summary ----------------
DAILY_SUMMARY_HOUR_UTC=21
