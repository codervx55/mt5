# ============================================================
# MT5-STYLE -> TELEGRAM SIGNAL BOT - ENVIRONMENT CONFIGURATION
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env file to GitHub.
#
# Market data comes from TwelveData instead of a live MT5 terminal, so this
# runs on Railway/a VPS/anywhere -- no Windows machine required. Tradeoff:
# prices are TwelveData's feed, not your broker's exact live quotes.
# ============================================================

# ---------------- TwelveData ----------------
# Get a free key at https://twelvedata.com/ (free tier: 8 requests/minute,
# 800/day -- see SCAN_INTERVAL_SECONDS note below).
TWELVEDATA_API_KEY=

# ---------------- Telegram ----------------
# Create a bot with @BotFather, then paste the token below.
TELEGRAM_BOT_TOKEN=
# Your personal chat id -- gets every signal + heartbeat/summary/commands.
TELEGRAM_CHAT_ID=
# Optional: a public channel (numeric id starts with -100) that also gets
# every signal, but NOT heartbeat/summary/startup messages. Leave blank to
# only send to TELEGRAM_CHAT_ID.
TELEGRAM_CHANNEL_ID=

# ---------------- Trading Pairs ----------------
# Comma separated list of symbol names (mapped to TwelveData format
# internally -- see data/market_data.py SYMBOL_MAP for supported pairs).
SYMBOLS=BTCUSD,ETHUSD,XAUUSD

# Comma separated list of timeframes to scan. Supported: M1,M5,M15,M30,H1,H4,D1
TIMEFRAMES=M5,M15
# The higher timeframe used to confirm the lower timeframe signal.
CONFIRMATION_TIMEFRAME=M15

# ---------------- Strategy ----------------
RISK_REWARD_RATIO=2.6
VOLUME_LOOKBACK=20
VOLUME_MULTIPLIER=1.2
MIN_CONFIDENCE_SCORE=80

# Confidence weighting (must sum to 100, but the code will normalize if not)
WEIGHT_VWAP=20
WEIGHT_STRUCTURE=25
WEIGHT_VOLUME=20
WEIGHT_CANDLESTICK=20
WEIGHT_TREND=15

# ---------------- Duplicate Protection ----------------
SIGNAL_COOLDOWN_MINUTES=30
ACTIVE_SIGNALS_FILE=signals/active_signals.json

# ---------------- Sessions (UTC) ----------------
# Options: LONDON, NEWYORK, BOTH, OFF
SESSION_FILTER=BOTH
LONDON_SESSION_START=07:00
LONDON_SESSION_END=16:00
NEWYORK_SESSION_START=12:00
NEWYORK_SESSION_END=21:00

# ---------------- Scanner ----------------
# IMPORTANT: each scan cycle fetches len(SYMBOLS) x len(TIMEFRAMES) candle
# sets (plus confirmation-timeframe fetches), each a TwelveData API call.
# With the default 3 symbols x 2 timeframes = ~6 calls/cycle, a free-tier
# 8-req/minute cap means this MUST run far less often than the old 10s MT5
# polling interval. 300 (5 min) is a safe default; go lower only if you've
# upgraded your TwelveData plan or trimmed SYMBOLS/TIMEFRAMES.
SCAN_INTERVAL_SECONDS=300

# ---------------- Logging ----------------
LOG_FILE=logs/bot.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# ---------------- CSV History ----------------
CSV_HISTORY_FILE=signals/signal_history.csv

# ---------------- Heartbeat ----------------
HEARTBEAT_INTERVAL_HOURS=6

# ---------------- Daily Summary ----------------
DAILY_SUMMARY_HOUR_UTC=21

